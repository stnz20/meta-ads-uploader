# Kopiere diese Datei nach .streamlit/secrets.toml für lokale Tests mit st.secrets
# Auf Streamlit Cloud: Inhalt direkt unter Settings → Secrets eintragen
#
# WICHTIG: secrets.toml NIEMALS committen — steht in .gitignore

META_APP_ID         = ""
META_APP_SECRET     = ""
META_ACCESS_TOKEN   = ""
META_AD_ACCOUNT_ID  = "act_..."
META_PAGE_ID        = ""
META_PIXEL_ID       = ""
GOOGLE_SHEET_ID     = ""
ADS_DRIVE_FOLDER_ID = ""

# Google Service Account — Inhalt von credentials.json als eine Zeile (JSON-String)
# Beispiel: GOOGLE_CREDENTIALS_JSON = '{"type":"service_account","project_id":"..."}'
GOOGLE_CREDENTIALS_JSON = ""

# ── Frame.io-Import (optional — nur für die Seite "Frame.io Import") ──
# OAuth als Workspace-Nutzer für Drive-Uploads (Refresh Token via mint_drive_refresh_token.py)
GOOGLE_OAUTH_CLIENT_ID     = ""
GOOGLE_OAUTH_CLIENT_SECRET = ""
GOOGLE_OAUTH_REFRESH_TOKEN = ""
# Zwischen-Ordner: Frame.io-Rohdateien landen hier, dann benennt Ad Naming sie um
FRAMEIO_STAGING_FOLDER_ID  = ""
# Static-Ablage ("24 All Static Ads …") — STA-Ads gehen hierher, sonst ADS_DRIVE_FOLDER_ID
STATIC_DRIVE_FOLDER_ID     = ""
