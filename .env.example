# Meta API
# App-ID und Secret aus developers.facebook.com → Dein App → Einstellungen → Allgemeines
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret

# Long-Lived System User Token (KEIN normaler User-Token!)
# Erstellen: Business Manager → Systembenutzer → Token generieren
# Berechtigungen: ads_management, ads_read, business_management, pages_show_list
META_ACCESS_TOKEN=EAAxxxxx...

# Ad Account ID inkl. "act_"-Präfix (z.B. act_123456789)
# Zu finden: business.facebook.com → Ad Accounts
META_AD_ACCOUNT_ID=act_XXXXXXXXX

# Facebook Page ID (die Seite, von der Ads ausgespielt werden)
# Zu finden: facebook.com/your-page → Info → Seiten-ID
META_PAGE_ID=XXXXXXXXX

# Meta Pixel ID — Fallback für promoted_object, wenn das Referenz-Ad-Set keines liefert
META_PIXEL_ID=

# Optional: ABO-Testing-Kampagne, aus der der Upload-Assistent Referenz-Ad-Sets vorschlägt (leer = aus)
ABO_TESTING_CAMPAIGN_ID=

# Google Sheets
# Pfad zur Service-Account-JSON-Datei (NIEMALS ins Git committen!)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Google Sheet ID — aus der URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id

# Ad Namer — Google Drive Ordner-ID des Ablage-Ordners (alle fertigen Ads)
ADS_DRIVE_FOLDER_ID=your_ablage_folder_id
# GID des Naming-Convention-Tabs im Google Sheet
NAMING_SHEET_GID=0

# ── Frame.io-Import (optional — nur für die Seite "Frame.io Import") ──
# Google-OAuth für Drive-Uploads als Workspace-Nutzer (Service Account hat keine
# My-Drive-Quota). Client in der Google Cloud Console anlegen (Desktop app,
# Consent Screen "Internal"), dann Refresh Token erzeugen:
#   python3 mint_drive_refresh_token.py
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Zwischen-Ordner: Frame.io-Rohdateien landen hier, danach benennt Ad Naming sie um
FRAMEIO_STAGING_FOLDER_ID=
# Static-Ablage-Ordner ("24 All Static Ads …") — Ad Naming schiebt STA-Ads hierher,
# UGC/VID/VSL nach ADS_DRIVE_FOLDER_ID. Leer → alles nach ADS_DRIVE_FOLDER_ID.
STATIC_DRIVE_FOLDER_ID=

# ── Ad Naming (optional) ──
# Creator-/Agenturnamen, die in Rohdateinamen vorkommen und kein Konzept sind (kommagetrennt)
KNOWN_CREATORS=
# Vorbelegter Creator im Ad-Naming-Formular
DEFAULT_CREATOR=
# Drive-Ordner, die Asset Link Sync standardmäßig scannt (kommagetrennt, URLs oder IDs)
ASSET_SYNC_FOLDER_URLS=
